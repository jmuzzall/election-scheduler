<%- include('partials/header') %>

<!-- ── Top navbar ─────────────────────────────────── -->
<nav class="navbar navbar-dark home-navbar">
  <div class="container-fluid px-4">
    <span class="navbar-brand home-brand">
      <i class="bi bi-calendar-check me-2"></i>Sunday Duty Deacon Rotation Scheduler
    </span>
    <a href="/admin/login" class="btn btn-admin-corner">
      <i class="bi bi-shield-lock me-1"></i> Admin
    </a>
  </div>
</nav>

<!-- ── Hero ──────────────────────────────────────── -->
<div class="home-hero">
  <div class="home-hero-overlay"></div>
  <div class="container home-hero-content text-center">
    <h1 class="home-title">Sunday Duty Deacon Rotation</h1>
    <p class="home-subtitle">McLean Presbyterian Church</p>
    <div class="home-divider"></div>
  </div>
</div>

<!-- ── Login card ────────────────────────────────── -->
<div class="home-body">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="card home-card shadow">
          <div class="card-body p-5 text-center">
            <div class="home-card-icon mb-3">
              <i class="bi bi-person-circle"></i>
            </div>
            <h3 class="home-card-title mb-2">Deacon Portal</h3>
            <p class="text-muted mb-4">
              Sign in to submit your availability or view the upcoming Sunday duty schedule.
            </p>
            <a href="/candidate/login" class="btn btn-gold btn-lg w-100 mb-3">
              <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </a>
            <p class="text-muted small mb-0">
              <i class="bi bi-info-circle me-1"></i>First-time users will set a password on sign-in.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ── Footer ────────────────────────────────────── -->
<footer class="home-footer text-center">
  <p class="mb-0 small">
    &copy; <%= new Date().getFullYear() %> McLean Presbyterian Church &mdash; Sunday Duty Deacon Rotation Scheduler
  </p>
</footer>

<%- include('partials/footer') %>
