<%- include('partials/header') %>

<div class="landing-page">
  <div class="container">
    <div class="text-center mb-5">
      <h1 class="display-4 fw-bold text-white">
        <i class="bi bi-calendar-check"></i> Sunday Duty Scheduler
      </h1>
      <p class="lead text-white-50">Manage and schedule Sunday duty assignments with fairness</p>
    </div>

    <div class="row justify-content-center g-4">
      <!-- Admin Login Card -->
      <div class="col-md-5">
        <div class="card shadow-lg border-0 h-100">
          <div class="card-body text-center p-5">
            <div class="mb-4">
              <i class="bi bi-shield-lock display-1 text-primary"></i>
            </div>
            <h3 class="card-title mb-3">Administrator</h3>
            <p class="text-muted mb-4">
              Manage candidates, configure scheduling, and generate duty assignments.
            </p>
            <a href="/admin/login" class="btn btn-primary btn-lg w-100">
              <i class="bi bi-box-arrow-in-right"></i> Admin Login
            </a>
          </div>
        </div>
      </div>

      <!-- Candidate Access Card -->
      <div class="col-md-5">
        <div class="card shadow-lg border-0 h-100">
          <div class="card-body text-center p-5">
            <div class="mb-4">
              <i class="bi bi-person-circle display-1 text-success"></i>
            </div>
            <h3 class="card-title mb-3">Candidate</h3>
            <p class="text-muted mb-4">
              Submit your availability for Sunday duty scheduling.
            </p>
            <a href="/candidate/login" class="btn btn-success btn-lg w-100">
              <i class="bi bi-box-arrow-in-right"></i> Candidate Login
            </a>
            <p class="text-muted small mt-3">
              <i class="bi bi-info-circle"></i> Sign in with your email. First-time users will create a password.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
