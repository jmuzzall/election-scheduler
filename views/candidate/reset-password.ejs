<% const title = 'Reset Password' %>
<%- include('../partials/header') %>

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light">
  <div class="card shadow-sm border-0" style="width: 100%; max-width: 420px;">
    <div class="card-body p-4">
      <div class="text-center mb-4">
        <i class="bi bi-shield-lock display-4 text-success"></i>
        <h3 class="mt-2">Reset Password</h3>
      </div>

      <% if (success) { %>
        <div class="alert alert-success">
          <i class="bi bi-check-circle"></i>
          <strong>Password updated!</strong> You can now log in with your new password.
        </div>
        <div class="text-center mt-3">
          <a href="/candidate/login" class="btn btn-success">
            <i class="bi bi-box-arrow-in-right"></i> Go to Login
          </a>
        </div>

      <% } else if (!valid) { %>
        <div class="alert alert-danger">
          <i class="bi bi-exclamation-triangle"></i>
          <%= error || 'This reset link is invalid or has expired.' %>
        </div>
        <div class="text-center mt-3">
          <a href="/candidate/forgot-password" class="btn btn-warning">
            <i class="bi bi-arrow-repeat"></i> Request a New Link
          </a>
        </div>

      <% } else { %>
        <% if (error) { %>
          <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> <%= error %></div>
        <% } %>
        <form method="POST" action="/candidate/reset-password">
          <input type="hidden" name="token" value="<%= token %>">
          <div class="mb-3">
            <label class="form-label">New Password</label>
            <input type="password" class="form-control" name="new_password"
              placeholder="At least 6 characters" minlength="6" required autofocus>
          </div>
          <div class="mb-3">
            <label class="form-label">Confirm New Password</label>
            <input type="password" class="form-control" name="confirm_password"
              placeholder="Re-enter your password" minlength="6" required>
          </div>
          <button type="submit" class="btn btn-success w-100">
            <i class="bi bi-check-lg"></i> Set New Password
          </button>
        </form>
      <% } %>

      <div class="text-center mt-3">
        <a href="/candidate/login" class="text-muted small">
          <i class="bi bi-arrow-left"></i> Back to Login
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
