<% const title = 'My Availability' %>
<% const activePage = 'portal' %>
<%- include('../partials/header') %>
<%- include('../partials/candidate-nav') %>

<div class="container mt-4">
  <!-- Countdown / Status Banner -->
  <% if (isLocked) { %>
    <div class="alert alert-warning border-0 shadow-sm">
      <h5 class="alert-heading"><i class="bi bi-lock"></i> Deadline Passed</h5>
      <p class="mb-0">The deadline to submit availability has passed. You have been marked as available for all Sundays. Please contact the Admin if you need an emergency change.</p>
    </div>
  <% } else if (settings.input_deadline) { %>
    <div class="alert alert-info border-0 shadow-sm">
      <h5 class="alert-heading"><i class="bi bi-clock"></i> Submission Deadline</h5>
      <p class="mb-0">
        You have <strong><span id="countdown"></span></strong> left to submit your availability.
        <br><small class="text-muted">Deadline: <%= new Date(settings.input_deadline).toLocaleString() %></small>
      </p>
    </div>
  <% } else { %>
    <div class="alert alert-info border-0 shadow-sm">
      <h5 class="alert-heading"><i class="bi bi-info-circle"></i> No Deadline Set</h5>
      <p class="mb-0">The administrator has not set a submission deadline yet. You can submit your availability at any time.</p>
    </div>
  <% } %>

  <!-- ── Assigned Dates Banner ───────────────────── -->
  <% if (myAssignments && myAssignments.length > 0) { %>
    <div class="card border-0 shadow-sm mb-4" style="border-left:4px solid var(--mp-gold) !important;">
      <div class="card-header fw-bold d-flex align-items-center gap-2" style="background:var(--mp-navy);color:#fff;">
        <i class="bi bi-calendar-check-fill"></i>
        Your Assigned Sundays
        <span class="badge bg-warning text-dark ms-1"><%= myAssignments.length %> date<%= myAssignments.length !== 1 ? 's' : '' %></span>
      </div>
      <div class="card-body py-2 px-3">
        <div class="row g-2">
          <% for (const a of myAssignments) { %>
            <%
              const d = new Date(a.date + 'T00:00:00');
              const formatted = d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
            %>
            <div class="col-sm-6 col-lg-4">
              <div class="d-flex align-items-center gap-2 p-2 rounded" style="background:#f0f4f8;">
                <i class="bi bi-calendar2-week text-success fs-5"></i>
                <div>
                  <div class="fw-semibold small"><%= formatted %></div>
                  <div class="text-muted" style="font-size:0.78rem;"><i class="bi bi-geo-alt"></i> <%= a.location_name %></div>
                </div>
              </div>
            </div>
          <% } %>
        </div>
        <div class="mt-2">
          <a href="/candidate/schedule" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-calendar3"></i> View Full Schedule
          </a>
          <% if (myAssignments.length > 0) { %>
            <a href="/candidate/swaps" class="btn btn-sm btn-outline-secondary ms-2">
              <i class="bi bi-arrow-left-right"></i> Request a Swap
            </a>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>

  <!-- ── Upcoming Assignments Banner ─────────────── -->
  <% if (myDraftAssignments && myDraftAssignments.length > 0) { %>
    <div class="card border-0 shadow-sm mb-4" style="border-left:4px solid var(--mp-gold) !important; opacity:0.92;">
      <div class="card-header fw-bold d-flex align-items-center gap-2" style="background:#5a6d1e;color:#fff;">
        <i class="bi bi-calendar2-plus"></i>
        Upcoming Assignments <span class="badge bg-warning text-dark ms-1" style="font-size:0.75rem;">PLANNED</span>
        <span class="badge" style="background:rgba(255,255,255,0.2);font-size:0.75rem;"><%= myDraftAssignments.length %> date<%= myDraftAssignments.length !== 1 ? 's' : '' %></span>
      </div>
      <div class="card-body py-2 px-3">
        <p class="text-muted small mb-2">Your planned assignments for the upcoming period — not yet finalized.</p>
        <div class="row g-2">
          <% for (const a of myDraftAssignments) { %>
            <%
              const dd = new Date(a.date + 'T00:00:00');
              const dformatted = dd.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
            %>
            <div class="col-sm-6 col-lg-4">
              <div class="d-flex align-items-center gap-2 p-2 rounded" style="background:#f5f8ee;">
                <i class="bi bi-calendar2-week text-success fs-5"></i>
                <div>
                  <div class="fw-semibold small"><%= dformatted %></div>
                  <div class="text-muted" style="font-size:0.78rem;"><i class="bi bi-geo-alt"></i> <%= a.location_name %></div>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>

  <% if (!settings.schedule_start_date || !settings.schedule_end_date) { %>
    <div class="alert alert-secondary">
      <i class="bi bi-exclamation-circle"></i> The schedule date range has not been configured yet. Please check back later.
    </div>
  <% } else { %>
    <div class="row g-4">
      <!-- Left column: instructions + actions -->
      <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white fw-bold">
            <i class="bi bi-info-circle"></i> Instructions
          </div>
          <div class="card-body">
            <ol class="mb-0">
              <li class="mb-2">Click <strong>"Open Calendar"</strong> below to open the date picker.</li>
              <li class="mb-2">The calendar only shows dates from <strong><%= settings.schedule_start_date %></strong> to <strong><%= settings.schedule_end_date %></strong>.</li>
              <li class="mb-2">Tap on <strong>Sundays</strong> you are <strong>NOT available</strong> to work. Tap again to deselect.</li>
              <li class="mb-2">Selected (red) Sundays = <span class="text-danger fw-bold">Unavailable</span>.</li>
              <li class="mb-2">Click <strong>"Done"</strong> when finished selecting dates.</li>
              <li>Click <strong>"Save Availability"</strong> to submit your selections.</li>
            </ol>
          </div>
        </div>

        <% if (candidate.has_submitted_input) { %>
          <div class="alert alert-success mt-3">
            <i class="bi bi-check-circle"></i> You have already submitted your availability.
            <% if (!isLocked) { %>You can still update it before the deadline.<% } %>
          </div>
        <% } %>

        <% if (!isLocked) { %>
          <div class="d-grid gap-2 mt-3">
            <button class="btn btn-lg btn-outline-primary" id="btnOpenCalendar" type="button">
              <i class="bi bi-calendar-event"></i> Open Calendar
            </button>
            <button class="btn btn-lg btn-primary" id="btnSave" onclick="saveBlackouts()">
              <i class="bi bi-check-lg"></i> Save Availability
            </button>
          </div>
        <% } %>
        <div id="saveResult" class="mt-2"></div>
      </div>

      <!-- Right column: selected dates summary -->
      <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white fw-bold">
            <i class="bi bi-calendar-x"></i> Your Unavailable Sundays
          </div>
          <div class="card-body">
            <div id="selectedSummary">
              <p class="text-muted mb-0">No dates selected yet.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Calendar Popup Modal -->
    <div class="modal fade" id="calendarModal" tabindex="-1" aria-labelledby="calendarModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="calendarModalLabel">
              <i class="bi bi-calendar-event"></i> Select Unavailable Sundays
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <p class="text-muted small mb-3">
              Tap on <strong>Sundays</strong> you <strong>cannot</strong> work. Only Sundays within the schedule range are selectable. Tap again to deselect.
            </p>
            <div id="calendar-container"></div>
          </div>
          <div class="modal-footer">
            <span class="me-auto text-muted small" id="popupSelectionCount">0 Sundays marked unavailable</span>
            <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
              <i class="bi bi-check-lg"></i> Done
            </button>
          </div>
        </div>
      </div>
    </div>
  <% } %>
</div>

<div class="container mt-3">
  <!-- ── Upcoming Period Availability ─────────────── -->
  <% if (settings.draft_start_date && settings.draft_end_date && !draftIsLocked) { %>
    <div class="card border-0 shadow-sm mt-4">
      <div class="card-header fw-bold d-flex align-items-center gap-2" style="background:#3d5a8a;color:#fff;">
        <i class="bi bi-calendar2-plus"></i> Upcoming Period Availability
        <span class="badge bg-warning text-dark ms-1" style="font-size:0.75rem;">NEW</span>
      </div>
      <div class="card-body">
        <% if (settings.draft_input_deadline) { %>
          <div class="alert alert-info py-2 mb-3">
            <i class="bi bi-clock"></i> Submit your unavailability for the <strong>upcoming</strong> period
            (<%= settings.draft_start_date %> – <%= settings.draft_end_date %>) by
            <strong><%= new Date(settings.draft_input_deadline).toLocaleString() %></strong>.
          </div>
        <% } else { %>
          <div class="alert alert-info py-2 mb-3">
            <i class="bi bi-info-circle"></i> Mark any Sundays you cannot serve in the <strong>upcoming</strong> period
            (<%= settings.draft_start_date %> – <%= settings.draft_end_date %>).
          </div>
        <% } %>
        <div class="row g-4">
          <div class="col-lg-5">
            <div class="d-grid gap-2">
              <button class="btn btn-outline-primary" id="btnOpenDraftCalendar" type="button">
                <i class="bi bi-calendar-event"></i> Open Upcoming Calendar
              </button>
              <button class="btn btn-primary" id="btnSaveDraft" onclick="saveDraftBlackouts()">
                <i class="bi bi-check-lg"></i> Save Upcoming Availability
              </button>
            </div>
            <div id="saveDraftResult" class="mt-2"></div>
          </div>
          <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
              <div class="card-header bg-white fw-bold">
                <i class="bi bi-calendar-x"></i> Your Unavailable Sundays (Upcoming)
              </div>
              <div class="card-body">
                <div id="draftSelectedSummary">
                  <p class="text-muted mb-0">No dates selected yet.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Upcoming Calendar Modal -->
    <div class="modal fade" id="draftCalendarModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title"><i class="bi bi-calendar-event"></i> Upcoming Period — Select Unavailable Sundays</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <p class="text-muted small mb-3">Tap Sundays you <strong>cannot</strong> serve in the upcoming period.</p>
            <div id="draft-calendar-container"></div>
          </div>
          <div class="modal-footer">
            <span class="me-auto text-muted small" id="draftPopupCount">0 Sundays marked unavailable</span>
            <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
              <i class="bi bi-check-lg"></i> Done
            </button>
          </div>
        </div>
      </div>
    </div>
  <% } else if (settings.draft_start_date && settings.draft_end_date && draftIsLocked) { %>
    <div class="alert alert-secondary mt-4">
      <i class="bi bi-lock"></i> The availability deadline for the upcoming period has passed.
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>

<script src="/js/candidate-portal.js"></script>
<script>
<% if (settings.schedule_start_date && settings.schedule_end_date) { %>
  initCandidatePortal({
    startDate: '<%= settings.schedule_start_date %>',
    endDate: '<%= settings.schedule_end_date %>',
    deadline: '<%= settings.input_deadline || '' %>',
    blackoutDates: <%- JSON.stringify(blackoutDates) %>,
    isLocked: <%= isLocked ? 'true' : 'false' %>
  });
<% } %>

<% if (settings.draft_start_date && settings.draft_end_date && !draftIsLocked) { %>
  // ── Draft availability calendar ──────────────────────────────────────────
  let draftSelectedDates = new Set(<%- JSON.stringify(draftBlackoutDates) %>);

  function renderDraftCalendar() {
    const start = new Date('<%= settings.draft_start_date %>T00:00:00');
    const end   = new Date('<%= settings.draft_end_date %>T00:00:00');
    const container = document.getElementById('draft-calendar-container');
    container.innerHTML = '';

    // Group Sundays by month
    const sundays = [];
    const cur = new Date(start);
    while (cur.getDay() !== 0) cur.setDate(cur.getDate() + 1);
    while (cur <= end) {
      sundays.push(new Date(cur));
      cur.setDate(cur.getDate() + 7);
    }

    const byMonth = {};
    for (const s of sundays) {
      const key = s.getFullYear() + '-' + String(s.getMonth() + 1).padStart(2, '0');
      if (!byMonth[key]) byMonth[key] = [];
      byMonth[key].push(s);
    }

    for (const [key, days] of Object.entries(byMonth)) {
      const [yr, mo] = key.split('-');
      const label = new Date(+yr, +mo - 1, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
      const block = document.createElement('div');
      block.innerHTML = `<div class="fw-semibold mb-1 mt-2">${label}</div>`;
      const row = document.createElement('div');
      row.className = 'd-flex flex-wrap gap-2 mb-2';
      for (const d of days) {
        const iso = d.toISOString().split('T')[0];
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn-sm ' + (draftSelectedDates.has(iso) ? 'btn-danger' : 'btn-outline-secondary');
        btn.textContent = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        btn.dataset.date = iso;
        btn.onclick = () => {
          if (draftSelectedDates.has(iso)) {
            draftSelectedDates.delete(iso);
            btn.className = 'btn btn-sm btn-outline-secondary';
          } else {
            draftSelectedDates.add(iso);
            btn.className = 'btn btn-sm btn-danger';
          }
          updateDraftPopupCount();
          updateDraftSummary();
        };
        row.appendChild(btn);
      }
      block.appendChild(row);
      container.appendChild(block);
    }
    updateDraftPopupCount();
    updateDraftSummary();
  }

  function updateDraftPopupCount() {
    const el = document.getElementById('draftPopupCount');
    if (el) el.textContent = draftSelectedDates.size + ' Sunday' + (draftSelectedDates.size !== 1 ? 's' : '') + ' marked unavailable';
  }

  function updateDraftSummary() {
    const el = document.getElementById('draftSelectedSummary');
    if (!el) return;
    const sorted = [...draftSelectedDates].sort();
    if (sorted.length === 0) {
      el.innerHTML = '<p class="text-muted mb-0">No dates selected.</p>';
    } else {
      el.innerHTML = sorted.map(iso => {
        const d = new Date(iso + 'T00:00:00');
        return `<span class="badge bg-danger me-1 mb-1">${d.toLocaleDateString('en-US', {month:'short',day:'numeric',year:'numeric'})}</span>`;
      }).join('');
    }
  }

  document.getElementById('btnOpenDraftCalendar').addEventListener('click', () => {
    renderDraftCalendar();
    new bootstrap.Modal(document.getElementById('draftCalendarModal')).show();
  });

  async function saveDraftBlackouts() {
    const btn = document.getElementById('btnSaveDraft');
    const result = document.getElementById('saveDraftResult');
    btn.disabled = true;
    try {
      const resp = await fetch('/candidate/save-draft-blackouts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ dates: [...draftSelectedDates] })
      });
      const data = await resp.json();
      if (data.success) {
        result.innerHTML = '<div class="alert alert-success py-2">' + data.message + '</div>';
      } else {
        result.innerHTML = '<div class="alert alert-danger py-2">' + data.error + '</div>';
      }
    } catch(e) {
      result.innerHTML = '<div class="alert alert-danger py-2">Failed to save.</div>';
    }
    btn.disabled = false;
    updateDraftSummary();
  }

  // Render summary on page load
  updateDraftSummary();
<% } %>
</script>
