<% const title = 'Locations' %>
<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>

<div class="container mt-4">
  <h2 class="mb-4"><i class="bi bi-geo-alt"></i> Locations</h2>

  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show">
      <i class="bi bi-check-circle"></i> <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show">
      <i class="bi bi-exclamation-triangle"></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="row g-4">
    <!-- Add Location -->
    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-bold">
          <i class="bi bi-plus-circle"></i> Add Location
        </div>
        <div class="card-body">
          <form method="POST" action="/admin/locations/add">
            <div class="mb-3">
              <label class="form-label">Location Name</label>
              <input type="text" class="form-control" name="name" placeholder="e.g., Main Hall" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Slots Per Day</label>
              <input type="number" class="form-control" name="slots_per_day" value="1" min="1" required>
              <div class="form-text">Number of candidates needed at this location per day</div>
            </div>
            <button type="submit" class="btn btn-primary w-100">
              <i class="bi bi-plus-lg"></i> Add Location
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Location List -->
    <div class="col-md-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-bold">
          <i class="bi bi-list"></i> All Locations (<%= locations.length %>)
        </div>
        <div class="card-body p-0">
          <% if (locations.length === 0) { %>
            <div class="text-center py-5 text-muted">
              <i class="bi bi-geo-alt display-4"></i>
              <p class="mt-2">No locations yet. Add one to get started.</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Name</th>
                    <th class="text-center">Slots Per Day</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% for (const loc of locations) { %>
                    <tr>
                      <td><%= loc.name %></td>
                      <td class="text-center"><%= loc.slots_per_day %></td>
                      <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" title="Edit"
                          data-bs-toggle="modal" data-bs-target="#editLocModal"
                          onclick="openLocEditModal(<%= loc.id %>, '<%= loc.name.replace(/'/g, "\\'") %>', <%= loc.slots_per_day %>)">
                          <i class="bi bi-pencil"></i>
                        </button>
                        <form method="POST" action="/admin/locations/<%= loc.id %>/delete" class="d-inline"
                          onsubmit="return confirm('Delete location: <%= loc.name.replace(/'/g, "\\'") %>?')">
                          <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Edit Location Modal -->
<div class="modal fade" id="editLocModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="editLocForm" method="POST">
        <div class="modal-header">
          <h5 class="modal-title">Edit Location</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" name="name" id="editLocName" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Slots Per Day</label>
            <input type="number" class="form-control" name="slots_per_day" id="editLocSlots" min="1" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function openLocEditModal(id, name, slots) {
  document.getElementById('editLocForm').action = '/admin/locations/' + id + '/edit';
  document.getElementById('editLocName').value = name;
  document.getElementById('editLocSlots').value = slots;
}
</script>

<%- include('../partials/footer') %>
