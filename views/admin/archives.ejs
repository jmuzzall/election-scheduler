<% const title = 'Archives' %>
<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>

<div class="container-fluid mt-4 px-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-archive"></i> Schedule Archives</h2>
    <a href="/admin/schedule" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-calendar-check"></i> Go to Schedule
    </a>
  </div>

  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show">
      <i class="bi bi-check-circle"></i> <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show">
      <i class="bi bi-exclamation-triangle"></i> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- Lookback status banner -->
  <% if (lookbackWindow > 0) { %>
    <div class="alert border-0 mb-4" style="background:#e8f0f7;">
      <i class="bi bi-clock-history me-2" style="color:var(--mp-navy);"></i>
      <strong>Historical Fairness is active:</strong>
      the scheduling algorithm is considering the
      <% if (lookbackType === 'months') { %>
        most recent <strong><%= lookbackWindow %> month<%= lookbackWindow > 1 ? 's' : '' %></strong> of archives.
      <% } else { %>
        <strong><%= lookbackWindow %> most recent</strong> archived period<%= lookbackWindow > 1 ? 's' : '' %>.
      <% } %>
      Archives marked <span class="badge ms-1" style="background:var(--mp-navy);">In Lookback</span> are included in the next schedule generation.
      <a href="/admin/settings" class="ms-2 small">Change in Settings →</a>
    </div>
  <% } else { %>
    <div class="alert alert-light border mb-4">
      <i class="bi bi-info-circle me-2 text-muted"></i>
      <strong>Historical fairness is off.</strong>
      The scheduling algorithm only considers the current period.
      <a href="/admin/settings" class="ms-2 small">Enable in Settings →</a>
    </div>
  <% } %>

  <% if (archives.length === 0) { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-archive display-1"></i>
      <p class="mt-3 lead">No archives yet.</p>
      <p>After generating a schedule, click <strong>Archive Schedule</strong> on the Schedule page to save a permanent record.</p>
      <a href="/admin/schedule" class="btn btn-outline-primary mt-2">
        <i class="bi bi-calendar-check"></i> Go to Schedule
      </a>
    </div>
  <% } else { %>
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Label</th>
                <th>Period</th>
                <th class="text-center">Assignments</th>
                <th>Archived</th>
                <th>By</th>
                <th class="text-center">Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% for (const a of archives) { %>
                <tr>
                  <td class="fw-semibold"><%= a.label %></td>
                  <td class="text-muted small">
                    <% if (a.period_start && a.period_end) { %>
                      <%= new Date(a.period_start + 'T00:00:00').toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %>
                      &ndash;
                      <%= new Date(a.period_end + 'T00:00:00').toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %>
                    <% } else { %>
                      <span class="text-muted">—</span>
                    <% } %>
                  </td>
                  <td class="text-center"><%= a.assignment_count %></td>
                  <td class="text-muted small">
                    <%= new Date(a.created_at).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %>
                  </td>
                  <td class="text-muted small"><%= a.created_by_name %></td>
                  <td class="text-center">
                    <% if (a.inLookback) { %>
                      <span class="badge" style="background:var(--mp-navy);">In Lookback</span>
                    <% } else { %>
                      <span class="badge bg-light text-muted border">Archived</span>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <a href="/admin/archives/<%= a.id %>" class="btn btn-sm btn-outline-primary me-1">
                      <i class="bi bi-eye"></i> View
                    </a>
                    <a href="/api/export-archive/<%= a.id %>" class="btn btn-sm btn-outline-success me-1">
                      <i class="bi bi-file-earmark-excel"></i>
                    </a>
                    <form method="POST" action="/admin/archives/<%= a.id %>/delete" class="d-inline"
                      onsubmit="return confirm('Permanently delete archive \'<%= a.label %>\'? This cannot be undone.')">
                      <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
