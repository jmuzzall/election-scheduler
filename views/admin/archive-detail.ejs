<% const title = archive.label %>
<%- include('../partials/header') %>
<%- include('../partials/admin-nav') %>

<div class="container-fluid mt-4 px-4">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
    <div>
      <nav aria-label="breadcrumb" class="mb-1">
        <ol class="breadcrumb mb-0 small">
          <li class="breadcrumb-item"><a href="/admin/archives">Archives</a></li>
          <li class="breadcrumb-item active"><%= archive.label %></li>
        </ol>
      </nav>
      <h2 class="mb-0"><i class="bi bi-archive me-2"></i><%= archive.label %></h2>
      <% if (archive.notes) { %>
        <p class="text-muted mb-0 mt-1"><%= archive.notes %></p>
      <% } %>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <a href="/api/export-archive/<%= archive.id %>" class="btn btn-outline-success">
        <i class="bi bi-file-earmark-excel"></i> Export Excel
      </a>
      <form method="POST" action="/admin/archives/<%= archive.id %>/delete" class="d-inline"
        onsubmit="return confirm('Permanently delete this archive? This cannot be undone.')">
        <button type="submit" class="btn btn-outline-danger">
          <i class="bi bi-trash"></i> Delete Archive
        </button>
      </form>
    </div>
  </div>

  <!-- Meta cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase fw-bold mb-1" style="font-size:.7rem;letter-spacing:.06em;">Period</div>
          <div class="fw-semibold">
            <% if (archive.period_start && archive.period_end) { %>
              <%= new Date(archive.period_start + 'T00:00:00').toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %>
              –
              <%= new Date(archive.period_end + 'T00:00:00').toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %>
            <% } else { %>
              <span class="text-muted">Not recorded</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase fw-bold mb-1" style="font-size:.7rem;letter-spacing:.06em;">Assignments</div>
          <div class="fw-semibold display-6 lh-1" style="color:var(--mp-navy);"><%= archive.assignment_count %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase fw-bold mb-1" style="font-size:.7rem;letter-spacing:.06em;">Archived</div>
          <div class="fw-semibold">
            <%= new Date(archive.created_at).toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' }) %>
          </div>
          <div class="text-muted small">by <%= archive.created_by_name %></div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted small text-uppercase fw-bold mb-1" style="font-size:.7rem;letter-spacing:.06em;">Deacons</div>
          <div class="fw-semibold display-6 lh-1" style="color:var(--mp-navy);"><%= byCandidate.length %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">

    <!-- Schedule table -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-bold">
          <i class="bi bi-calendar3"></i> Full Schedule
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <% const dates = Object.keys(grid).sort(); %>
            <% if (dates.length === 0) { %>
              <p class="text-muted p-3 mb-0">No assignments recorded in this archive.</p>
            <% } else { %>
              <table class="table table-bordered table-hover mb-0 small">
                <thead class="table-dark">
                  <tr>
                    <th style="min-width:130px;">Date</th>
                    <% for (const loc of locationNames) { %>
                      <th><%= loc %></th>
                    <% } %>
                  </tr>
                </thead>
                <tbody>
                  <% for (const date of dates) { %>
                    <tr>
                      <td class="fw-semibold text-nowrap">
                        <%
                          const d = new Date(date + 'T00:00:00');
                          const day = d.toLocaleDateString('en-US', { weekday:'short' });
                          const fmt = d.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
                        %>
                        <span class="badge bg-primary me-1"><%= day %></span><%= fmt %>
                      </td>
                      <% for (const loc of locationNames) { %>
                        <td>
                          <% const names = (grid[date] && grid[date][loc]) || []; %>
                          <% for (const name of names) { %>
                            <div class="small"><%= name %></div>
                          <% } %>
                        </td>
                      <% } %>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Per-deacon summary -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-bold">
          <i class="bi bi-people"></i> Participation Summary
        </div>
        <div class="card-body p-0">
          <table class="table table-hover mb-0 small">
            <thead class="table-light">
              <tr>
                <th>Deacon</th>
                <th class="text-center">Shifts</th>
              </tr>
            </thead>
            <tbody>
              <% for (const c of byCandidate) { %>
                <tr>
                  <td>
                    <%= c.name %>
                    <div class="text-muted" style="font-size:.7rem;"><%= c.email %></div>
                  </td>
                  <td class="text-center">
                    <span class="badge" style="background:var(--mp-navy);"><%= c.count %></span>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>
