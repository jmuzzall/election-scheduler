<% const title = 'Forgot Password' %>
<%- include('../partials/header') %>

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light">
  <div class="card shadow-sm border-0" style="width: 100%; max-width: 420px;">
    <div class="card-body p-4">
      <div class="text-center mb-4">
        <i class="bi bi-key display-4 text-warning"></i>
        <h3 class="mt-2">Forgot Password</h3>
        <p class="text-muted small mb-0">Admin account recovery</p>
      </div>

      <% if (sent) { %>
        <div class="alert alert-success">
          <i class="bi bi-envelope-check"></i>
          <strong>Check your email.</strong><br>
          If that address matches an admin account, we've sent a password reset link. It expires in 1 hour.
        </div>
        <div class="text-center mt-3">
          <a href="/admin/login" class="btn btn-primary">
            <i class="bi bi-box-arrow-in-right"></i> Back to Login
          </a>
        </div>
      <% } else { %>
        <% if (error) { %>
          <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> <%= error %></div>
        <% } %>
        <p class="text-muted">Enter your admin email address and we'll send you a reset link.</p>
        <form method="POST" action="/admin/forgot-password">
          <div class="mb-3">
            <label class="form-label">Email Address</label>
            <input type="email" class="form-control" name="email" placeholder="your@email.com" required autofocus>
          </div>
          <button type="submit" class="btn btn-warning w-100">
            <i class="bi bi-send"></i> Send Reset Link
          </button>
        </form>
        <div class="text-center mt-3">
          <a href="/admin/login" class="text-muted small">
            <i class="bi bi-arrow-left"></i> Back to Login
          </a>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
